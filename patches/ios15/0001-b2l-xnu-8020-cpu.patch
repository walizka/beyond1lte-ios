+	    ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
+	for (uint64_t done = 0; done < span; done += ARM_TT_L2_SIZE) {
+		vm_map_address_t va = B2L_EARLY_FB_VA + done;
+		tt_entry_t l1 = cpu_tte[L1_TABLE_T1_INDEX(va, TCR_EL1_BOOT)];
+		tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+		tt_entry_t *entry = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		if (*entry != ARM_TTE_EMPTY) panic("B2L console: framebuffer VA is already mapped");
+		*entry = (page_base + done) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+	return B2L_EARLY_FB_VA + offset;
+}
