@@ -219,6 +219,101 @@ early_random(void)
 	return result;
 }
 
+#if defined(ARM64_BOARD_CONFIG_B2L)
+/* Register the real built-in HMAC-SHA256 DRBG before allocator initialization.
+ * This registers only the kernel PRNG, not unrelated corecrypto services.
+ * Boot entropy validation and entropy health tests remain unchanged. */
+#include <kern/startup.h>
+static LCK_GRP_DECLARE(b2l_prng_group, "b2l-prng");
+static LCK_MTX_DECLARE(b2l_prng_lock, &b2l_prng_group);
+static struct cckprng_ctx b2l_prng_ctx;
+static const struct ccdrbg_nisthmac_custom b2l_prng_custom = {
+	.di = &ccsha256_ltc_di, .strictFIPS = 0,
+};
+static cckprng_getentropy b2l_getentropy;
+static void *b2l_getentropy_arg;
+static unsigned b2l_max_ngens;
+static bool b2l_generators[MAX_CPUS];
+
+static struct ccdrbg_state *b2l_prng_state(struct cckprng_ctx *ctx)
+{
+	return (struct ccdrbg_state *)ctx->drbg_state;
+}
+static void b2l_prng_check(int result)
+{
+	if (result != CCDRBG_STATUS_OK) panic("B2L HMAC DRBG error %d", result);
+}
+static void
+b2l_prng_init_with_getentropy(struct cckprng_ctx *ctx, unsigned max_ngens,
+    size_t seed_nbytes, const void *seed, size_t nonce_nbytes, const void *nonce,
+    cckprng_getentropy getentropy, void *getentropy_arg)
+{
+	assert(max_ngens > 0 && max_ngens <= MAX_CPUS);
+	ccdrbg_factory_nisthmac(&ctx->drbg_info, &b2l_prng_custom);
+	assert(ctx->drbg_info.size <= sizeof(ctx->drbg_state));
+	const char personalization[] = "xnu b2l kernel random";
+	b2l_prng_check(ccdrbg_init(&ctx->drbg_info, b2l_prng_state(ctx), seed_nbytes,
+	    seed, nonce_nbytes, nonce, sizeof(personalization) - 1, personalization));
+	b2l_getentropy = getentropy; b2l_getentropy_arg = getentropy_arg;
+	b2l_max_ngens = max_ngens;
+}
+static void
+b2l_prng_init(struct cckprng_ctx *ctx, size_t seed_nbytes, const void *seed,
+    size_t nonce_nbytes, const void *nonce, cckprng_getentropy getentropy, void *arg)
+{
+	b2l_prng_init_with_getentropy(ctx, MAX_CPUS, seed_nbytes, seed,
+	    nonce_nbytes, nonce, getentropy, arg);
+}
+static void b2l_prng_initgen(struct cckprng_ctx *ctx __unused, unsigned index)
+{
+	lck_mtx_lock(&b2l_prng_lock);
+	assert(index < b2l_max_ngens && !b2l_generators[index]);
+	b2l_generators[index] = true;
+	lck_mtx_unlock(&b2l_prng_lock);
+}
+static void b2l_prng_reseed(struct cckprng_ctx *ctx, size_t size, const void *seed)
+{
+	lck_mtx_lock(&b2l_prng_lock);
+	b2l_prng_check(ccdrbg_reseed(&ctx->drbg_info, b2l_prng_state(ctx), size, seed, 0, NULL));
+	lck_mtx_unlock(&b2l_prng_lock);
+}
+static void b2l_prng_refresh(struct cckprng_ctx *ctx)
+{
+	if (!lck_mtx_try_lock(&b2l_prng_lock)) return;
+	uint8_t entropy[CCKPRNG_ENTROPY_SIZE];
+	size_t size = sizeof(entropy);
+	int32_t samples = b2l_getentropy(&size, entropy, b2l_getentropy_arg);
+	if (samples < 0) panic("B2L PRNG entropy health test failed");
+	/* XNU 12377's SHA512 conditioner requires 512+64 accepted samples. */
+	if (samples >= 512 + 64) {
+		assert(size >= SEED_SIZE && size <= sizeof(entropy));
+		b2l_prng_check(ccdrbg_reseed(&ctx->drbg_info, b2l_prng_state(ctx), size, entropy, 0, NULL));
+	}
+	cc_clear(sizeof(entropy), entropy);
+	lck_mtx_unlock(&b2l_prng_lock);
+}
+static void b2l_prng_generate(struct cckprng_ctx *ctx, unsigned index, size_t size, void *out)
+{
+	assert(size <= CCKPRNG_GENERATE_MAX_NBYTES);
+	lck_mtx_lock(&b2l_prng_lock);
+	assert(index < b2l_max_ngens && b2l_generators[index]);
+	b2l_prng_check(ccdrbg_generate(&ctx->drbg_info, b2l_prng_state(ctx), size, out, 0, NULL));
+	lck_mtx_unlock(&b2l_prng_lock);
+}
+__startup_func static void b2l_prng_startup(void)
+{
+	(void)early_random(); /* Populate boot-derived seeds before registration. */
+	const struct cckprng_funcs funcs = {
+		.init = b2l_prng_init, .initgen = b2l_prng_initgen,
+		.reseed = b2l_prng_reseed, .refresh = b2l_prng_refresh,
+		.generate = b2l_prng_generate, .init_with_getentropy = b2l_prng_init_with_getentropy,
+	};
+	register_and_init_prng(&b2l_prng_ctx, &funcs);
+	kprintf("B2L PRNG: boot-seeded HMAC-SHA256 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, b2l_prng_startup);
+#endif
+
 static void
 read_random_generate(uint8_t *buffer, size_t numbytes);
 
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 760fbc7..fcd8374 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -16,7 +16,121 @@
 #endif
 
 
-#if HAS_GIC_V3
+#if defined(B2L)
+/*
+ * Exynos 9820 exposes the GICv2 non-secure CPU interface.  The architected
+ * virtual timer is PPI 27 and is delivered as IRQ (Group 1), not Apple FIQ.
+ * Firmware retains the secure-world distributor configuration.
+ */
+static vm_offset_t b2l_gicd;
+static vm_offset_t b2l_gicc;
+static volatile uint64_t b2l_timer_irqs;
+static volatile uint64_t b2l_signal_irqs;
+
+static uint32_t
+b2l_gic_read(vm_offset_t base, unsigned offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+b2l_gic_write(vm_offset_t base, unsigned offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+}
+
+uint32_t
+b2l_irq_ack(void)
+{
+	return b2l_gic_read(b2l_gicc, 0x00c); /* GICC_IAR, preserve SGI source bits */
+}
+
+void
+b2l_irq_eoi(uint32_t iar)
+{
+	b2l_gic_write(b2l_gicc, 0x010, iar);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+b2l_send_self_ipi(void)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	b2l_gic_write(b2l_gicd, 0xf00, (2U << 24) | 1U);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+b2l_irq_record(unsigned intid)
+{
+	if (intid == B2L_TIMER_INTID) {
+		b2l_timer_irqs++;
+	} else if (intid == 1) {
+		b2l_signal_irqs++;
+	}
+}
+
+uint64_t
+b2l_irq_count(boolean_t timer)
+{
+	return timer ? b2l_timer_irqs : b2l_signal_irqs;
+}
+
+void
+pe_init_fiq(void)
+{
+	if (b2l_gicd == 0) {
+		DTEntry entry;
+		const void *prop;
+		unsigned size;
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+		    SecureDTGetProperty(entry, "reg", &prop, &size) != kSuccess ||
+		    size != 4 * sizeof(uint64_t)) {
+			panic("B2L GIC: missing GICv2 MMIO ranges");
+		}
+		const uint64_t *reg = prop;
+		uint64_t soc = pe_arm_get_soc_base_phys();
+		/* Refuse an unrelated firmware tree before touching controller MMIO. */
+		if (soc + reg[0] != B2L_GICD_PA || soc + reg[2] != B2L_GICC_PA ||
+		    reg[1] != 0x1000 || reg[3] != 0x1000) {
+			panic("B2L GIC: unexpected Exynos 9820 register ranges");
+		}
+		b2l_gicd = ml_io_map(soc + reg[0], reg[1]);
+		b2l_gicc = ml_io_map(soc + reg[2], reg[3]);
+		if (!b2l_gicd || !b2l_gicc) {
+			panic("B2L GIC: cannot map controller");
+		}
+		/* No peripheral drivers exist in the first-boot target.  Mask stale
+		 * non-secure firmware SPIs; secure interrupt bits are RAZ/WI here. */
+		unsigned banks = (b2l_gic_read(b2l_gicd, 0x004) & 31U) + 1;
+		for (unsigned bank = 1; bank < banks; ++bank) {
+			b2l_gic_write(b2l_gicd, 0x180 + bank * 4, UINT32_MAX);
+			b2l_gic_write(b2l_gicd, 0x280 + bank * 4, UINT32_MAX);
+		}
+	}
+	const uint32_t sources = (1U << B2L_TIMER_INTID) | (1U << 1);
+	b2l_gic_write(b2l_gicd, 0x180, UINT32_MAX); /* banked PPI/SGI masks */
+	b2l_gic_write(b2l_gicd, 0x080,
+	    b2l_gic_read(b2l_gicd, 0x080) | sources); /* Group 1 */
+	b2l_gic_write(b2l_gicd, 0x280, sources);
+	/* Banked priorities: SGI1 and virtual timer PPI27. */
+	*(volatile uint8_t *)(b2l_gicd + 0x401) = 0x80;
+	*(volatile uint8_t *)(b2l_gicd + 0x400 + B2L_TIMER_INTID) = 0xa0;
+	b2l_gic_write(b2l_gicd, 0x100, sources);
+	b2l_gic_write(b2l_gicc, 0x004, 0xff); /* priority mask */
+	b2l_gic_write(b2l_gicc, 0x008, 0);    /* no priority grouping */
+	/* Non-secure bit0 is EnableGrp1; bit9 selects split EOI/deactivate.
+	 * Use combined EOI so GICC_EOIR deactivates as well as drops priority. */
+	b2l_gic_write(b2l_gicc, 0x000,
+	    (b2l_gic_read(b2l_gicc, 0x000) & ~(1U << 9)) | 1U);
+	b2l_gic_write(b2l_gicd, 0x000,
+	    b2l_gic_read(b2l_gicd, 0x000) | 1U);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("B2L GIC: GICv2 IRQ ready, timer=%u, SGI=1, CNTFRQ=%llu Hz\n",
+	    B2L_TIMER_INTID, __builtin_arm_rsr64("CNTFRQ_EL0"));
+}
+#elif HAS_GIC_V3
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
