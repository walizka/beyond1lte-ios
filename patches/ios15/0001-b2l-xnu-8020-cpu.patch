 #include <libkern/crypto/rand.h>
+#if defined(ARM64_BOARD_CONFIG_B2L)
+#include <sys/random.h>
+/* Internal XNU declaration from kern/misc_protos.h, not exported to libkern. */
+extern uint64_t early_random(void);
+#include <limits.h>
+#include <kern/assert.h>
+#include "b2l_kmem_random.h"
