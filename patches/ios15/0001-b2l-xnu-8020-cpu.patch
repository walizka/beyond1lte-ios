@@ -43,6 +51,19 @@ cc_rand_generate(void *out, size_t outlen)
 		}
 	}
 
+#if defined(ARM64_BOARD_CONFIG_B2L)
+	if (g_crypto_funcs == NULL) {
+		/* Genuine boot-seeded early DRBG, then the registered kernel DRBG. */
+		uint8_t *cursor = out;
+		while (outlen != 0) {
+			u_int chunk = outlen > UINT_MAX ? UINT_MAX : (u_int)outlen;
+			read_frandom(cursor, chunk);
